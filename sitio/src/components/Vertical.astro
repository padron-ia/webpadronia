---
import Base from "../layouts/Base.astro";

interface Props {
  sector: string;
  ruta: string;
  titulo: string;
  descripcion: string;
  pregunta: string;
  preguntaAcento: string;
  entradilla: string;
  bloques: { t: string; d: string }[];
  caso: { titular: string; antes: string; monte: string };
}

const { sector, ruta, titulo, descripcion, pregunta, preguntaAcento, entradilla, bloques, caso } =
  Astro.props;
---

<Base titulo={titulo} descripcion={descripcion} ruta={ruta}>
  <section class="hero">
    <div class="contenedor">
      <p class="rotulo">{sector}</p>
      <h1>
        {pregunta}<br />
        <span class="hero__acento">{preguntaAcento}</span>
      </h1>
      <p class="parrafo hero__sub">{entradilla}</p>
      <div class="hero__acciones">
        <a class="boton" href="/#hablamos">Cuéntame cómo lo hacéis hoy</a>
        <p class="hero__nota">15 minutos. Sin presupuesto de por medio.</p>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <p class="rotulo">Qué se hace solo</p>
      <h2 class="titulo-seccion">Lo que deja de estar en la lista de alguien</h2>
      <ul class="bloques">
        {
          bloques.map((b) => (
            <li>
              <h3>{b.t}</h3>
              <p class="parrafo">{b.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="seccion seccion--oscura">
    <div class="contenedor">
      <p class="rotulo">Un caso real, sin nombre</p>
      <h2 class="titulo-seccion">{caso.titular}</h2>
      <div class="caso-largo">
        <p class="parrafo"><strong>Antes.</strong> {caso.antes}</p>
        <p class="parrafo"><strong>Lo que monté.</strong> {caso.monte}</p>
      </div>
      <p class="parrafo caso-largo__nota">
        Está funcionando ahora mismo. Puedes verlo respondiendo en el
        <a class="enlace-acento" href="/#panel">panel en vivo</a>.
      </p>
      <p class="caso-largo__accion"><a class="boton" href="/#hablamos">Cuéntame tu caso</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 7vw, 6rem) clamp(2.5rem, 2rem + 4vw, 5rem);
    background:
      radial-gradient(70rem 36rem at 12% -10%, rgba(90, 103, 232, 0.12), transparent 60%),
      var(--bone);
  }

  .hero h1 {
    margin-block: 1rem 1.4rem;
    max-width: 18ch;
    font-size: clamp(2.1rem, 1.3rem + 3.6vw, 3.4rem);
  }

  .hero__acento { color: var(--iris); }
  .hero__sub { font-size: var(--t-m); }

  .hero__acciones {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.4rem;
  }

  .hero__nota { font-size: var(--t-s); color: var(--texto-tenue); }

  .titulo-seccion { margin-block: 0.9rem 1.1rem; }

  .bloques {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.5rem 3rem;
  }

  @media (min-width: 52rem) {
    .bloques { grid-template-columns: repeat(3, 1fr); }
  }

  .bloques li { border-top: 2px solid var(--ink); padding-top: 1rem; }
  .bloques h3 { margin-bottom: 0.35rem; }

  .caso-largo {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 46rem;
  }

  .caso-largo strong { color: var(--sobre-oscuro); }
  .caso-largo__nota { margin-top: 1.5rem; font-size: var(--t-s); }
  .caso-largo__accion { margin-top: 1.75rem; }
</style>
